{
  "expo": {
    "name": "Pilar",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1F45"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "backgroundColor": "#0F1F45"
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "themeColor": "#0F1F45",
      "backgroundColor": "#0F1F45",
      "name": "Pilar",
      "shortName": "Pilar",
      "description": "Plataforma de Inovação Local Articulada em Recife",
      "lang": "pt-BR",
      "scope": "/",
      "startUrl": "/",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
